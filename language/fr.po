msgid "Verify SSL Certificate"
msgstr "Vérifier le certificat SSL"

msgid "Whether to verify SSL certificates for Elasticsearch connections. Disable for Docker deployments with xpack.security.enabled=false or self-signed certificates."
msgstr "Vérifier les certificats SSL pour les connexions Elasticsearch. À désactiver pour les déploiements Docker avec xpack.security.enabled=false ou des certificats auto-signés."

# EmbeddingSection
msgid "Embeddings Service URL"
msgstr "URL du service d'embeddings"

msgid "URL of the embeddings generation service (e.g., http://localhost:8000)"
msgstr "URL du service de génération d'embeddings (ex. : http://localhost:8000)"

msgid "Embedding Vector Dimension"
msgstr "Dimension du vecteur d'embedding"

msgid "Size of the embedding vectors produced by the embeddings service. Must match the model in use (e.g., 384 for all-MiniLM-L6-v2, 768 for all-mpnet-base-v2, 1024 for BAAI/bge-m3 or bge-large, 1536 for text-embedding-3-small). Changing this value requires clearing the vector store collection and running a full reindex."
msgstr "Taille des vecteurs d'embedding produits par le service d'embeddings. Doit correspondre au modèle utilisé (ex. : 384 pour all-MiniLM-L6-v2, 768 pour all-mpnet-base-v2, 1024 pour BAAI/bge-m3 ou bge-large, 1536 pour text-embedding-3-small). Changer cette valeur nécessite de vider la collection du magasin vectoriel et d'effectuer une réindexation complète."

# LlmSection
msgid "Select the LLM provider for generating search assistant responses"
msgstr "Sélectionner le fournisseur LLM pour générer les réponses de l'assistant"

msgid "Claude API Key"
msgstr "Clé API Claude"

msgid "Anthropic Claude API key for search assistant responses (required when Claude provider is selected, format: sk-ant-...)"
msgstr "Clé API Anthropic Claude pour les réponses de l'assistant (requise quand le fournisseur Claude est sélectionné, format : sk-ant-...)"

msgid "Claude Model"
msgstr "Modèle Claude"

msgid "Select the Claude model to use for generating responses"
msgstr "Sélectionner le modèle Claude à utiliser pour générer les réponses"

msgid "Max Tokens"
msgstr "Tokens maximum"

msgid "Maximum number of tokens in the response (1-4096)"
msgstr "Nombre maximum de tokens dans la réponse (1-4096)"

msgid "Temperature"
msgstr "Température"

msgid "Sampling temperature for response generation (0.0 = deterministic, 1.0 = creative)"
msgstr "Température d'échantillonnage pour la génération (0.0 = déterministe, 1.0 = créatif)"

msgid "Self-hosted LLM URL"
msgstr "URL du LLM auto-hébergé"

msgid "URL of your self-hosted LLM. Ollama: http://localhost:11434 when it runs natively on the host (macOS/Linux), http://ollama:11434 when it runs in Docker on the same compose network. OpenAI-compatible: the server base URL, with or without /v1 (e.g. http://vllm:8000)."
msgstr "URL de votre LLM auto-hébergé. Ollama : http://localhost:11434 lorsqu'il s'exécute en natif sur la machine hôte (macOS/Linux), http://ollama:11434 lorsqu'il s'exécute dans Docker sur le même réseau compose. Compatible OpenAI : l'URL de base du serveur, avec ou sans /v1 (ex. : http://vllm:8000)."

msgid "Self-hosted LLM Model"
msgstr "Modèle du LLM auto-hébergé"

msgid "Name of the model served by your self-hosted LLM (e.g., llama3.2, mistral for Ollama; google/gemma-3-12b-it for vLLM)."
msgstr "Nom du modèle servi par votre LLM auto-hébergé (ex. : llama3.2, mistral pour Ollama ; google/gemma-3-12b-it pour vLLM)."

msgid "Self-hosted (Ollama or OpenAI-compatible)"
msgstr "Auto-hébergé (Ollama ou compatible OpenAI)"

msgid "Self-hosted LLM"
msgstr "LLM auto-hébergé"

msgid "Self-hosted LLM API format"
msgstr "Format d'API du LLM auto-hébergé"

msgid "API spoken by the server. \"Ollama\" uses /api/chat and /api/tags. \"OpenAI-compatible\" uses /v1/chat/completions and /v1/models (vLLM, TGI, LiteLLM, Ollama)."
msgstr "API utilisée par le serveur. « Ollama » utilise /api/chat et /api/tags. « Compatible OpenAI » utilise /v1/chat/completions et /v1/models (vLLM, TGI, LiteLLM, Ollama)."

msgid "Ollama (native API)"
msgstr "Ollama (API native)"

msgid "OpenAI-compatible (vLLM, TGI...)"
msgstr "Compatible OpenAI (vLLM, TGI...)"

msgid "Embeddings API format"
msgstr "Format d'API des embeddings"

msgid "\"Native\" posts {\"text\": [...]} to /embed. \"OpenAI-compatible\" posts {\"model\", \"input\"} to /v1/embeddings (vLLM, TEI, Ollama...)."
msgstr "« Natif » envoie {\"text\": [...]} à /embed. « Compatible OpenAI » envoie {\"model\", \"input\"} à /v1/embeddings (vLLM, TEI, Ollama...)."

msgid "Native (/embed)"
msgstr "Natif (/embed)"

msgid "OpenAI-compatible (/v1/embeddings)"
msgstr "Compatible OpenAI (/v1/embeddings)"

msgid "Embeddings Model"
msgstr "Modèle d'embeddings"

msgid "Model name sent to the server (required for the OpenAI-compatible format, e.g. BAAI/bge-multilingual-gemma2). Ignored by the native format."
msgstr "Nom du modèle envoyé au serveur (obligatoire pour le format compatible OpenAI, ex. : BAAI/bge-multilingual-gemma2). Ignoré par le format natif."

# AdvancedSection
msgid "Search Result Limit"
msgstr "Nombre max. de résultats"

msgid "Maximum number of search results to retrieve from the vector store (1-50)"
msgstr "Nombre maximum de résultats à récupérer depuis le magasin vectoriel (1-50)"

msgid "Enable Question Caching"
msgstr "Activer la mise en cache des questions"

msgid "Cache frequently asked questions to improve response time"
msgstr "Mettre en cache les questions fréquentes pour améliorer le temps de réponse"

msgid "Enable Verbose Logging"
msgstr "Activer les logs détaillés"

msgid "Log detailed debugging information (useful for troubleshooting)"
msgstr "Enregistrer les informations de débogage détaillées (utile pour le dépannage)"

msgid "Auto-process Indexing Queue"
msgstr "Traiter automatiquement la file d'indexation"

msgid "Automatically process the indexing queue when items are created or updated"
msgstr "Traiter automatiquement la file d'indexation lors de la création ou mise à jour d'items"

msgid "Per-IP Request Limit"
msgstr "Limite de requêtes par IP"

msgid "Maximum search assistant API requests allowed from a single client IP per window (default: 10). Set higher for shared networks or if sitting behind a reverse proxy."
msgstr "Nombre maximum de requêtes à l'API de l'assistant autorisées depuis une adresse IP par fenêtre (par défaut : 10). Augmenter cette valeur pour les réseaux partagés ou derrière un reverse proxy."

msgid "Per-IP Window (seconds)"
msgstr "Fenêtre par IP (secondes)"

msgid "Sliding window duration in seconds for the per-IP request limit (default: 60)."
msgstr "Durée de la fenêtre glissante en secondes pour la limite par IP (par défaut : 60)."

msgid "LLM Token Budget (per window)"
msgstr "Budget de tokens LLM (par fenêtre)"

msgid "Organization-wide input-token ceiling for the configured LLM provider, shared across all clients (default: 30000 = Anthropic tier-1 limit). Adjust to match your provider plan."
msgstr "Plafond de tokens d'entrée à l'échelle de l'organisation pour le fournisseur LLM configuré, partagé entre tous les clients (par défaut : 30000 = limite Anthropic tier-1). À ajuster selon votre plan."

msgid "LLM Token Window (seconds)"
msgstr "Fenêtre de tokens LLM (secondes)"

msgid "Sliding window duration in seconds for the organization-wide token budget (default: 60)."
msgstr "Durée de la fenêtre glissante en secondes pour le budget de tokens (par défaut : 60)."

msgid "Response Generation Instruction"
msgstr "Instruction de génération de réponse"

msgid "Instruction appended to the response generation prompt sent to the LLM. Tells the model how to use the search results to answer the user."
msgstr "Instruction ajoutée au prompt de génération de réponse envoyé au LLM. Indique au modèle comment utiliser les résultats de recherche pour répondre à l'utilisateur."

# ConfigFormRenderer messenger warning
msgid "Vector store settings changed. Run a full reindex so that search uses the new settings."
msgstr "Les réglages du magasin vectoriel ont changé. Lancez une réindexation complète pour que la recherche utilise les nouveaux réglages."

# /admin/search-assistant/prompts — PromptsController / view / form / nav
msgid "Prompts"
msgstr "Prompts"

msgid "Search Assistant AI Prompts"
msgstr "Prompts de Search Assistant AI"

msgid "Edit the prompts the search assistant uses. Values are stored in the Omeka settings table and take effect on the next chat request. The reference examples under config/prompts/ are copied into the settings the first time the module boots; edits after that point are preserved."
msgstr "Modifiez les prompts utilisés par le search_assistant. Les valeurs sont stockées dans la table de paramètres Omeka et prennent effet à la prochaine requête de chat. Les exemples de référence sous config/prompts/ sont copiés dans les paramètres au premier démarrage du module ; les modifications effectuées ensuite sont conservées."

msgid "Search Assistant AI instructions"
msgstr "Instructions de l'assistant"

msgid "Search Assistant AI instructions (plain text)"
msgstr "Instructions de l'assistant (texte)"

msgid "Plain-text system instructions passed to the LLM before every user turn."
msgstr "Instructions système en texte brut transmises au LLM avant chaque tour de l'utilisateur."

msgid "Criteria extraction template"
msgstr "Modèle d'extraction des critères"

msgid "Criteria extraction template (YAML)"
msgstr "Modèle d'extraction des critères (YAML)"

msgid "YAML template used to extract search criteria from a user question."
msgstr "Modèle YAML utilisé pour extraire les critères de recherche à partir d'une question utilisateur."

msgid "Response generation template"
msgstr "Modèle de génération de réponse"

msgid "Response generation template (YAML)"
msgstr "Modèle de génération de réponse (YAML)"

msgid "YAML template used to build the final LLM response from search results."
msgstr "Modèle YAML utilisé pour construire la réponse finale du LLM à partir des résultats de recherche."

msgid "Show shipped example — %s (%d characters)"
msgstr "Afficher l'exemple fourni — %s (%d caractères)"

msgid "Save prompts"
msgstr "Enregistrer les prompts"

msgid "Prompts saved."
msgstr "Prompts enregistrés."

msgid "Please fix the validation errors below."
msgstr "Veuillez corriger les erreurs de validation ci-dessous."

# /admin/search-assistant/indexing — nav + page
msgid "Indexing"
msgstr "Indexation"

msgid "Search Assistant AI Indexing"
msgstr "Indexation de Search Assistant AI"

# /admin/search-assistant/config — renamed from "Configuration" to "Interface"
msgid "Interface"
msgstr "Interface"

msgid "Search Assistant AI Interface"
msgstr "Interface de Search Assistant AI"

# Auth-only widget gate
msgid "Restrict to authenticated users"
msgstr "Restreindre aux utilisateurs authentifiés"

msgid "When enabled, the search assistant widget and chat API are only available to signed-in Omeka users. Useful for testing the module before enabling it for public visitors."
msgstr "Lorsque cette option est activée, le widget et l'API de chat ne sont disponibles qu'aux utilisateurs connectés à Omeka. Pratique pour tester le module avant de l'ouvrir aux visiteurs du site."

msgid "Authentication required."
msgstr "Authentification requise."

msgid "Deactivate the %s module first: Search Assistant AI replaces it and imports its settings and data."
msgstr "Désactivez d'abord le module %s : Search Assistant AI le remplace et importe ses réglages et ses données."

msgid "Manual Reindex"
msgstr "Réindexation manuelle"

msgid "Complete Reindex"
msgstr "Réindexation complète"

msgid "Delete existing index entries and recreate from scratch"
msgstr "Supprime les entrées existantes de l'index et le reconstruit entièrement"

msgid "Incremental Reindex"
msgstr "Réindexation incrémentale"

msgid "Only index new resources not yet in vector database"
msgstr "Indexe seulement les nouvelles ressources absentes de la base vectorielle"

msgid "Specific Resources"
msgstr "Ressources précises"

msgid "Target specific resource IDs (comma-separated)"
msgstr "Cible des identifiants de ressources précis (séparés par des virgules)"

msgid "Asynchronous (Background)"
msgstr "Asynchrone (arrière-plan)"

msgid "Run as background job (recommended for large datasets)"
msgstr "Exécute une tâche en arrière-plan (recommandé pour les gros volumes)"

msgid "Synchronous (Wait)"
msgstr "Synchrone (attente)"

msgid "Wait for completion (only for small datasets)"
msgstr "Attend la fin du traitement (seulement pour les petits volumes)"

msgid "Item Sets (Collections)"
msgstr "Collections"

msgid "All Resource Types"
msgstr "Tous les types de ressources"

msgid "Hello! How can I help you?"
msgstr "Bonjour ! Comment puis-je vous aider ?"

msgid "Greeting shown when the widget opens. Leave empty for the default greeting in the visitor's language (max 500 characters)."
msgstr "Message affiché à l'ouverture du widget. Laissez vide pour le message par défaut, dans la langue du visiteur (500 caractères maximum)."

msgid "Method not allowed. Use POST."
msgstr "Méthode non autorisée. Utilisez POST."

msgid "Content-Type must be application/json"
msgstr "Content-Type doit être application/json"

msgid "Too many requests. Please try again in %d seconds."
msgstr "Limite de requêtes dépassée. Veuillez réessayer dans %d secondes."

msgid "Invalid JSON: %s"
msgstr "JSON invalide : %s"

msgid "Validation failed"
msgstr "Validation échouée"

msgid "The service is temporarily overloaded. Please try again in a few moments."
msgstr "Service temporairement surchargé. Veuillez réessayer dans quelques instants."

msgid "The service is temporarily unavailable. Please try again later."
msgstr "Service temporairement indisponible. Veuillez réessayer plus tard."

msgid "The \"query\" field is required"
msgstr "Le champ \"query\" est requis"

msgid "The query must contain at least 1 character"
msgstr "La requête doit contenir au moins 1 caractère"

msgid "The query cannot exceed 1000 characters"
msgstr "La requête ne peut pas dépasser 1000 caractères"

msgid "The sessionId must contain at least 1 character"
msgstr "Le sessionId doit contenir au moins 1 caractère"

msgid "The sessionId cannot exceed 255 characters"
msgstr "Le sessionId ne peut pas dépasser 255 caractères"

msgid "Configuration saved successfully."
msgstr "Configuration enregistrée."
