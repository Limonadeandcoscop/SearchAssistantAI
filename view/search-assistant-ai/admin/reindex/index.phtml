<!-- Inline JavaScript for form interactions and AJAX -->
<script>
(function() {
    'use strict';

    // Get CSRF token
    const csrfToken = document.getElementById('csrf-token').value;

    // Get form elements
    const form = document.getElementById('reindex-form');
    const resourceTypeSelect = document.getElementById('resource-type');
    const scopeRadios = document.querySelectorAll('input[name="scope"]');
    const resourceIdsField = document.getElementById('field-resource-ids');
    const resourceIdsInput = document.getElementById('resource-ids');
    const executionModeRadios = document.querySelectorAll('input[name="execution_mode"]');

    // Get action buttons
    const previewButton = document.getElementById('action-preview');
    const launchButton = document.getElementById('action-launch');
    const cancelButton = document.getElementById('action-cancel');

    // Get preview and progress elements
    const previewResults = document.getElementById('preview-results');
    const previewMessage = document.getElementById('preview-message');
    const progressSection = document.getElementById('section-progress');
    const logsSection = document.getElementById('section-logs');
    const progressBar = document.getElementById('progress-bar');
    const progressPercentage = document.getElementById('progress-percentage');
    const jobStatus = document.getElementById('job-status');
    const jobIdDisplay = document.getElementById('job-id');
    const logViewer = document.getElementById('log-viewer');

    // State
    let currentJobId = null;
    let pollingInterval = null;

    // Show/hide resource IDs field based on scope selection
    scopeRadios.forEach(function(radio) {
        radio.addEventListener('change', function() {
            if (this.value === 'specific') {
                resourceIdsField.style.display = 'block';
                resourceIdsInput.required = true;
            } else {
                resourceIdsField.style.display = 'none';
                resourceIdsInput.required = false;
            }
        });
    });

    // Preview button click handler
    previewButton.addEventListener('click', function() {
        const formData = getFormData();

        // Validate specific resource IDs if needed
        if (formData.scope === 'specific' && !formData.resource_ids) {
            showMessage('Please enter resource IDs for specific scope.', 'error');
            return;
        }

        // Disable button and show loading
        previewButton.disabled = true;
        previewButton.textContent = <?php echo json_encode($this->translate('Loading...'), JSON_UNESCAPED_UNICODE); ?>;

        // Make AJAX request to preview endpoint
        fetch('<?php echo $this->url('admin/search-assistant/reindex', ['action' => 'preview'], true); ?>', {
            method: 'POST',
            headers: {
                'X-Requested-With': 'XMLHttpRequest'
            },
            body: new URLSearchParams(formData)
        })
        .then(function(response) {
            return response.json();
        })
        .then(function(data) {
            if (data.success) {
                const count = data.data.count;
                previewMessage.textContent = <?php echo json_encode($this->translate('Resources to be reindexed:') . ' ', JSON_UNESCAPED_UNICODE); ?> + count;
                previewResults.style.display = 'block';

                // Enable launch button if count > 0
                if (count > 0) {
                    launchButton.disabled = false;
                } else {
                    launchButton.disabled = true;
                    showMessage(<?php echo json_encode($this->translate('No resources found with the selected criteria.'), JSON_UNESCAPED_UNICODE); ?>, 'warning');
                }
            } else {
                showMessage(data.message || <?php echo json_encode($this->translate('Preview failed.'), JSON_UNESCAPED_UNICODE); ?>, 'error');
            }
        })
        .catch(function(error) {
            showMessage(<?php echo json_encode($this->translate('Error during preview:') . ' ', JSON_UNESCAPED_UNICODE); ?> + error.message, 'error');
        })
        .finally(function() {
            previewButton.disabled = false;
            previewButton.textContent = <?php echo json_encode($this->translate('Preview'), JSON_UNESCAPED_UNICODE); ?>;
        });
    });

    // Launch button click handler
    launchButton.addEventListener('click', function() {
        const formData = getFormData();

        // Show confirmation for complete scope (deletion warning)
        if (formData.scope === 'complete') {
            if (!confirm(<?php echo json_encode($this->translate('Complete reindex will delete all existing index entries. Are you sure?'), JSON_UNESCAPED_UNICODE); ?>)) {
                return;
            }
        }

        // Disable buttons
        launchButton.disabled = true;
        previewButton.disabled = true;
        launchButton.textContent = <?php echo json_encode($this->translate('Launching...'), JSON_UNESCAPED_UNICODE); ?>;

        // Make AJAX request to launch endpoint
        fetch('<?php echo $this->url('admin/search-assistant/reindex', ['action' => 'launch'], true); ?>', {
            method: 'POST',
            headers: {
                'X-Requested-With': 'XMLHttpRequest'
            },
            body: new URLSearchParams(formData)
        })
        .then(function(response) {
            return response.json();
        })
        .then(function(data) {
            if (data.success) {
                currentJobId = data.data.job_id;
                jobIdDisplay.textContent = currentJobId;

                // Show progress section
                progressSection.style.display = 'block';
                logsSection.style.display = 'block';

                // Hide preview results
                previewResults.style.display = 'none';

                // Start polling for progress
                startProgressPolling();

                showMessage(<?php echo json_encode($this->translate('Reindex job started successfully.'), JSON_UNESCAPED_UNICODE); ?>, 'success');
            } else {
                showMessage(data.message || <?php echo json_encode($this->translate('Failed to launch reindex job.'), JSON_UNESCAPED_UNICODE); ?>, 'error');
                launchButton.disabled = false;
                previewButton.disabled = false;
            }
        })
        .catch(function(error) {
            showMessage(<?php echo json_encode($this->translate('Error launching job:') . ' ', JSON_UNESCAPED_UNICODE); ?> + error.message, 'error');
            launchButton.disabled = false;
            previewButton.disabled = false;
        })
        .finally(function() {
            launchButton.textContent = <?php echo json_encode($this->translate('Launch Reindex'), JSON_UNESCAPED_UNICODE); ?>;
        });
    });

    // Cancel button click handler
    cancelButton.addEventListener('click', function() {
        if (!currentJobId) return;

        if (!confirm(<?php echo json_encode($this->translate('Are you sure you want to cancel the reindex job?'), JSON_UNESCAPED_UNICODE); ?>)) {
            return;
        }

        cancelButton.disabled = true;

        fetch('<?php echo $this->url('admin/search-assistant/reindex', ['action' => 'cancel'], true); ?>', {
            method: 'POST',
            headers: {
                'X-Requested-With': 'XMLHttpRequest'
            },
            body: new URLSearchParams({ csrf: csrfToken, job_id: currentJobId })
        })
        .then(function(response) {
            return response.json();
        })
        .then(function(data) {
            if (data.success) {
                showMessage(<?php echo json_encode($this->translate('Job cancellation requested.'), JSON_UNESCAPED_UNICODE); ?>, 'success');
            } else {
                showMessage(data.message || <?php echo json_encode($this->translate('Failed to cancel job.'), JSON_UNESCAPED_UNICODE); ?>, 'error');
                cancelButton.disabled = false;
            }
        })
        .catch(function(error) {
            showMessage(<?php echo json_encode($this->translate('Error canceling job:') . ' ', JSON_UNESCAPED_UNICODE); ?> + error.message, 'error');
            cancelButton.disabled = false;
        });
    });

    // Get form data as object
    function getFormData() {
        const scope = document.querySelector('input[name="scope"]:checked').value;
        const executionMode = document.querySelector('input[name="execution_mode"]:checked').value;

        return {
            type: resourceTypeSelect.value,
            scope: scope,
            resource_ids: scope === 'specific' ? resourceIdsInput.value : '',
            execution_mode: executionMode,
            csrf: csrfToken
        };
    }

    // Start polling for job progress
    function startProgressPolling() {
        // Poll every 2 seconds
        pollingInterval = setInterval(updateProgress, 2000);

        // Immediate first update
        updateProgress();
    }

    // Update progress from API
    function updateProgress() {
        if (!currentJobId) return;

        fetch('<?php echo $this->url('admin/search-assistant/reindex', ['action' => 'progress'], true); ?>?job_id=' + currentJobId, {
            headers: {
                'X-Requested-With': 'XMLHttpRequest'
            }
        })
        .then(function(response) {
            return response.json();
        })
        .then(function(data) {
            if (data.success) {
                const status = data.data.status;
                const percentage = data.data.percentage || 0;
                const logs = data.data.logs || [];

                // Update status
                jobStatus.textContent = status;

                // Update progress bar
                progressBar.style.width = percentage + '%';
                progressPercentage.textContent = percentage + '%';

                // Replace logs: the endpoint returns the job's latest lines
                logViewer.textContent = '';
                if (logs.length > 0) {
                    logs.forEach(function(log) {
                        const logLine = document.createElement('div');
                        logLine.className = 'log-line';
                        logLine.textContent = log;
                        logViewer.appendChild(logLine);
                    });

                    // Auto-scroll to bottom
                    logViewer.scrollTop = logViewer.scrollHeight;
                }

                // Check if job is complete
                if (status === 'completed' || status === 'error' || status === 'stopped') {
                    stopProgressPolling();

                    if (status === 'completed') {
                        showMessage(<?php echo json_encode($this->translate('Reindex completed successfully!'), JSON_UNESCAPED_UNICODE); ?>, 'success');
                    } else if (status === 'error') {
                        showMessage(<?php echo json_encode($this->translate('Reindex job failed. Check logs for details.'), JSON_UNESCAPED_UNICODE); ?>, 'error');
                    } else {
                        showMessage(<?php echo json_encode($this->translate('Reindex job was cancelled.'), JSON_UNESCAPED_UNICODE); ?>, 'warning');
                    }

                    // Re-enable form
                    previewButton.disabled = false;
                    launchButton.disabled = true;
                }
            }
        })
        .catch(function(error) {
            // Silently fail to avoid breaking polling loop
        });
    }

    // Stop polling
    function stopProgressPolling() {
        if (pollingInterval) {
            clearInterval(pollingInterval);
            pollingInterval = null;
        }
    }

    // Show message to user
    function showMessage(message, type) {
        const messagesContainer = document.getElementById('status-messages');
        const messageDiv = document.createElement('div');
        messageDiv.className = type; // 'success', 'error', 'warning'
        messageDiv.textContent = message;

        messagesContainer.appendChild(messageDiv);

        // Auto-remove after 5 seconds
        setTimeout(function() {
            messageDiv.remove();
        }, 5000);
    }
})();
</script>
