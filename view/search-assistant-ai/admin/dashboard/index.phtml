<?php
/**
 * Admin dashboard view template for Search Assistant AI module
 *
 * This template renders the administrative dashboard with 4 main sections:
 * 1. Indexation State - Vector database statistics and indexation status
 * 2. Synchronization Status - Real-time sync monitoring
 * 3. Usage Metrics - Search Assistant AI usage statistics and analytics
 * 4. Technical Health - Service health monitoring (Qdrant, Embeddings, Claude API)
 *
 * Features real-time AJAX updates, Charts.js visualizations, and quick action buttons
 * for administrative tasks (reindex, sync, cache management, configuration testing).
 *
 * @var \Laminas\View\Renderer\PhpRenderer $this
 */

$this->htmlElement('body')->appendAttribute('class', 'search assistant dashboard');
$this->headTitle('Search Assistant AI Dashboard');
$this->headLink()->appendStylesheet($this->assetUrl('css/admin-dashboard.css', 'SearchAssistantAI'));
$this->headScript()->appendFile($this->assetUrl('js/admin-dashboard.js', 'SearchAssistantAI'));

// Get CSRF token from the form passed by the controller.
// DashboardActionForm adds its CSRF element manually under the name 'csrf'
// (Omeka's global Csrf initializer doesn't reliably fire for this form).
$csrfToken = $this->form->get('csrf')->getValue();
?>

<?php echo $this->pageTitle('Search Assistant AI Dashboard'); ?>

<!-- CSRF Token for JavaScript (hidden) -->
<input type="hidden" id="csrf-token" name="csrf" data-csrf-name="csrf" value="<?php echo $this->escapeHtml($csrfToken); ?>">

<div id="page-actions"
     data-vector-store-backend="<?php echo $this->escapeHtml($this->dashboardData['vectorStoreBackend']); ?>"
     data-vector-store-display-name="<?php echo $this->escapeHtml($this->dashboardData['vectorStoreDisplayName']); ?>"
     data-llm-display-name="<?php echo $this->escapeHtml($this->translate($this->dashboardData['llmDisplayName'])); ?>">
    <button type="button" id="action-reindex" class="button">
        <?php echo $this->translate('Reindex All'); ?>
    </button>
    <button type="button" id="action-sync" class="button">
        <?php echo $this->translate('Force Sync'); ?>
    </button>
    <button type="button" id="action-clear-cache" class="button">
        <?php echo $this->translate('Clear Cache'); ?>
