    <button type="button" id="action-test-config" class="button">
        <?php echo $this->translate('Test Configuration'); ?>
    </button>
    <button type="button" id="action-clear-vector-store" class="button">
        <?php echo sprintf($this->translate('Clear %s Data'), $this->escapeHtml($this->dashboardData['vectorStoreDisplayName'])); ?>
    </button>
</div>

<!-- Section 1: Indexation State -->
<fieldset id="section-indexation" class="dashboard-section">
